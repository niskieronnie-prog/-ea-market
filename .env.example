# Get both from Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME=EA Market Hub

# Optional (server only, never prefix with NEXT_PUBLIC_). Not required yet.
AI_PROVIDER_API_KEY=
AI_KILL_SWITCH=false
AMAZON_ASSOCIATES_TAG=
JUMIA_AFFILIATE_ID=

# ---- Milestone 2 (all server-only; never prefix with NEXT_PUBLIC_) ----
# Long random string (32+ chars). Its SHA-256 hash is stored in the DB (see end of migration 0002).
SERVER_RPC_KEY=
# 32+ chars. Protects POST /api/fx/refresh (call daily from a scheduler)
CRON_SECRET=
# One per partner that will POST signed webhooks to /api/webhooks/<partner>, e.g. WEBHOOK_SECRET_ACMESHOP
WEBHOOK_SECRET_PARTNER=

# Amazon Creators API (v3.x credentials). Requires approved Associates account.
CREATORS_API_CREDENTIAL_ID=
CREATORS_API_CREDENTIAL_SECRET=
CREATORS_API_VERSION=3.1
AMAZON_MARKETPLACE=www.amazon.com
# AMAZON_ASSOCIATES_TAG is the tracking ID for THAT marketplace

# AI (Anthropic). Copy the current per-million-token prices from Anthropic's pricing page; the app refuses to run AI without them.
AI_MODEL=claude-haiku-5-5
AI_COST_IN_USD_PER_MTOK=
AI_COST_OUT_USD_PER_MTOK=

# Email (Resend). EMAIL_FROM must be a sender/domain you verified with Resend.
RESEND_API_KEY=
EMAIL_FROM=
